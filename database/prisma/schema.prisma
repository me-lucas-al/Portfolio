generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  role      Roles    @default(USER)
  createdAt DateTime @default(now())
}

model Project {
  id            Int      @id @default(autoincrement())
  title         String
  titleEn       String?
  description   String?  @db.Text
  descriptionEn String?  @db.Text
  githubUrl     String
  technologies  String[]
  deployUrl     String?
  imagesUrl     String[]
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("projects")
}

model Experience {
  id            Int      @id @default(autoincrement())
  role          String
  roleEn        String?
  company       String
  startDate     DateTime
  endDate       DateTime?
  description   String   @db.Text
  descriptionEn String?  @db.Text
  techs         String[] 
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Education {
  id          Int      @id @default(autoincrement())
  course      String
  courseEn    String?
  institution String
  startDate   DateTime
  endDate     DateTime?
  type        String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum Roles {
  ADMIN
  USER
}

model SystemSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

model Link {
  id        Int      @id @default(autoincrement())
  title     String
  url       String
  icon      String 
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("links")
}
