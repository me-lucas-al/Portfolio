{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "db:generate": {
      "cache": false,
      "env": ["DATABASE_URL", "DIRECT_DATABASE_URL"]
    },
    "db:push": {
      "cache": false,
      "env": ["DATABASE_URL", "DIRECT_DATABASE_URL"]
    },
    "db:migrate": {
      "cache": false,
      "env": ["DATABASE_URL", "DIRECT_DATABASE_URL"]
    },
    "build": {
      "dependsOn": ["^build", "^db:generate", "^db:migrate"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "AUTH_SECRET",
        "JWT_SECRET",
        "SEED_ADMIN_USERNAME",
        "SEED_ADMIN_PASSWORD",
        "DATABASE_URL",
        "DIRECT_DATABASE_URL",
        "NEXT_PUBLIC_URL",
        "GEMINI_API_KEY",
        "ASSISTANT_ENABLED",
        "ASSISTANT_DAILY_BUDGET",
        "IP_HASH_SALT",
        "REPOS_TO_INDEX",
        "ASSISTANT_MODEL_CHAIN",
        "GEMINI_BASE_URL",
        "CLOUDINARY_CLOUD_NAME",
        "CLOUDINARY_API_KEY",
        "CLOUDINARY_API_SECRET",
        "ASSISTANT_VOICE_ENABLED",
        "SPEECH_TOKEN_SECRET",
        "ASSISTANT_TTS_DAILY_BUDGET",
        "ASSISTANT_TTS_MODEL",
        "ASSISTANT_TTS_VOICE"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "generate": {
      "dependsOn": ["^generate"]
    }
  }
}
