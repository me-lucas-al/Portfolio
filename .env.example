# Copy to .env (root) and to web/.env.local, then fill in real values.
# Every new var also needs to be registered in Vercel (Production + Preview).

# --- Auth ---
AUTH_SECRET=
JWT_SECRET=
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=

# --- App ---
NEXT_PUBLIC_API_URL="http://localhost:3000"
NEXT_PUBLIC_URL="http://localhost:3000"

# --- Database (Neon) ---
# Pooled endpoint (-pooler), used at runtime.
DATABASE_URL=
# Direct endpoint (no -pooler), used only by the Prisma CLI (migrations, shadow db).
DIRECT_DATABASE_URL=

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- AI Assistant (Gemini + RAG) ---
GEMINI_API_KEY=
# Kill-switch for the public /api/chat endpoint.
ASSISTANT_ENABLED="true"
# Global daily message budget across all visitors.
ASSISTANT_DAILY_BUDGET="200"
# Salt used to hash visitor IPs for rate limiting (never store raw IPs).
IP_HASH_SALT=
# Comma-separated "owner/repo" list of PUBLIC repositories to index as source code.
REPOS_TO_INDEX="me-lucas-al/portfolio"
# Comma-separated model fallback chain, tried in order on capacity errors (503/500/502/504).
# Defaults to "gemini-3.6-flash,gemini-3.5-flash" when unset.
ASSISTANT_MODEL_CHAIN=
# Overrides the Gemini API base URL. Local-dev only (e.g. pointing at a stub
# server to test retry/fallback behavior) — leave empty in production.
GEMINI_BASE_URL=

# --- Assistant voice (/api/tts, signed-token TTS) ---
# Kill-switch for both the `speech` field on /api/chat and the /api/tts
# endpoint itself. Defaults to muted - voice is opt-in.
ASSISTANT_VOICE_ENABLED="false"
# Secret used to sign/verify /api/tts's short-lived speech tokens. Deliberately
# separate from IP_HASH_SALT - a leaked token secret only lets someone request
# arbitrary TTS synthesis, not deanonymize IPs.
SPEECH_TOKEN_SECRET=
# Daily synthesis budget for /api/tts, counted independently from
# ASSISTANT_DAILY_BUDGET (one chat answer can now cost one chat-generation
# call AND one tts-synthesis call).
ASSISTANT_TTS_DAILY_BUDGET="50"
# Optional overrides; a hardcoded default (gemini-2.5-flash-preview-tts /
# "Achird") is used when unset. Voice choice is provisional pending a human
# listening test.
ASSISTANT_TTS_MODEL=
ASSISTANT_TTS_VOICE=

